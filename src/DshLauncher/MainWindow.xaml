<Window x:Class="DshLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DshLauncher"
        mc:Ignorable="d"
        Title="DeepSeek Harness 启动器" Height="660" Width="960"
        WindowStartupLocation="CenterScreen" MinWidth="760" MinHeight="520">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：状态 + 操作 -->
        <Border Grid.Row="0" Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="Gray" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="已停止" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="UrlText" Grid.Column="1" Text="" Foreground="Gray" Margin="20,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="启动" Width="70" Margin="0,0,6,0" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="停止" Width="70" Margin="0,0,6,0" Click="StopButton_Click"/>
                    <Button x:Name="RestartButton" Content="重启" Width="70" Margin="0,0,6,0" Click="RestartButton_Click"/>
                    <Button x:Name="OpenButton" Content="打开网页" Width="84" Click="OpenButton_Click"/>
                    <Button x:Name="RepairButton" Content="一键修复" Width="84" Margin="6,0,0,0" Click="RepairButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 下部：设置 + 分页 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="设置" Grid.Column="0" Padding="8" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="监听端口" Margin="0,4,0,2"/>
                    <TextBox x:Name="PortBox" Text="3080"/>
                    <TextBlock Text="绑定地址" Margin="0,6,0,2"/>
                    <TextBox x:Name="HostBox" Text="127.0.0.1"/>
                    <TextBlock Text="开机延迟(秒)" Margin="0,6,0,2"/>
                    <TextBox x:Name="DelayBox" Text="0"/>

                    <CheckBox x:Name="AutoOpenBrowserCheck" Content="自动打开浏览器" Margin="0,10,0,0"/>
                    <CheckBox x:Name="AutostartCheck" Content="开机自启" Margin="0,6,0,0"
                              Checked="AutostartCheck_Changed" Unchecked="AutostartCheck_Changed"/>
                    <CheckBox x:Name="AutostartSilentCheck" Content="开机静默启动" Margin="0,6,0,0"/>
                    <CheckBox x:Name="WatchdogCheck" Content="守护模式(崩溃自动重启)" Margin="0,6,0,0"
                              Checked="WatchdogCheck_Changed" Unchecked="WatchdogCheck_Changed"/>
                    <CheckBox x:Name="MinimizeToTrayCheck" Content="最小化到托盘" Margin="0,6,0,0"/>

                    <Button x:Name="SaveButton" Content="保存设置" Margin="0,14,0,0" Click="SaveButton_Click"/>
                    <TextBlock x:Name="SettingsHint" Text="" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </GroupBox>

            <TabControl Grid.Column="1">
                <TabItem Header="状态与日志">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="清空日志" Width="84" Margin="0,0,6,0" Click="ClearLog_Click"/>
                            <Button Content="打开日志目录" Width="104" Click="OpenLogDir_Click"/>
                        </StackPanel>
                        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12"/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="最近会话">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="刷新" Width="64" Margin="0,0,6,0" Click="RefreshSessions_Click"/>
                            <Button Content="打开所在文件夹" Width="110" Margin="0,0,6,0" Click="OpenSessionFolder_Click"/>
                            <Button Content="打开文件" Width="80" Click="OpenSessionFile_Click"/>
                        </StackPanel>
                        <ListBox x:Name="SessionList" FontFamily="Consolas" FontSize="12"/>
                    </DockPanel>
                </TabItem>

                <TabItem x:Name="MaintenanceTab" Header="维护">
                    <StackPanel Margin="6" VerticalAlignment="Top">
                        <GroupBox Header="一键自动修复">
                            <StackPanel Margin="6">
                                <Button Content="一键自动修复（检查 dsh / 清理残留 / 重装依赖 / 修复 koffi）" Click="RepairButton_Click"/>
                                <TextBlock x:Name="RepairHint" Text="" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBox x:Name="RepairOutput" IsReadOnly="True" TextWrapping="NoWrap" Height="110" Margin="0,6,0,0"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="备份 / 恢复" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <Button Content="备份配置 (打包 .dsh)" Click="Backup_Click"/>
                                <Button Content="恢复配置 (从备份)" Margin="0,6,0,0" Click="Restore_Click"/>
                                <TextBlock x:Name="BackupHint" Text="" Foreground="Gray" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="更新" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <TextBlock x:Name="VersionText" Text="" Margin="0,0,0,6"/>
                                <Button Content="检查更新" Click="CheckUpdate_Click"/>
                                <Button Content="更新 dsh 到最新版" Margin="0,6,0,0" Click="UpdateDsh_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="目录" Margin="0,10,0,0">
                            <StackPanel Margin="6">
                                <Button Content="打开 .dsh 配置目录" Click="OpenDshDir_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </TabItem>

                <TabItem Header="插件">
                    <DockPanel Margin="6">
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel>
                                <Button Content="刷新" Width="64" Margin="0,0,6,6" Click="RefreshPlugins_Click"/>
                                <TextBox x:Name="PluginInstallBox" Width="240" Margin="0,0,6,6" VerticalContentAlignment="Center"
                                         ToolTip="包名 / name@version / github:repo / file:path"/>
                                <Button Content="安装插件" Width="90" Margin="0,0,6,6" Click="InstallPlugin_Click"/>
                                <Button Content="卸载选中" Width="90" Margin="0,0,6,6" Click="UninstallPlugin_Click"/>
                                <Button Content="重装依赖" Width="90" Margin="0,0,6,6" Click="ReinstallDeps_Click"/>
                                <Button Content="扫描残留" Width="90" Margin="0,0,6,6" Click="ScanLeftovers_Click"/>
                                <Button Content="清理残留" Width="90" Margin="0,0,6,6" Click="CleanLeftovers_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="PluginHint" Text="" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        </StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="120"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="PluginList" Grid.Row="0" FontFamily="Consolas" FontSize="12"/>
                            <TextBlock Grid.Row="2" Text="操作输出" Margin="0,0,0,2"/>
                            <TextBox x:Name="PluginOutput" Grid.Row="3" IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12"/>
                        </Grid>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
