<Window x:Class="DshLauncher.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Harness 启动器 — 一键安装" Height="580" Width="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Text="DeepSeek Harness 启动器 · 安装向导"/>
        <TextBlock x:Name="IntroText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#444"/>

        <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <CheckBox x:Name="ShortcutCheck" Content="创建桌面快捷方式（一键启动）" IsChecked="True"/>
            <CheckBox x:Name="AutostartCheck" Content="开机自启动（登录后静默拉起 harness）" Margin="0,6,0,0"/>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="3" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Background="#F7F7F7"/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="InstallButton" Content="开始安装" Width="110" Height="34" Click="InstallButton_Click"/>
                <Button x:Name="NodeButton" Content="下载 Node.js" Width="116" Height="34" Margin="8,0,0,0" Visibility="Collapsed" Click="NodeButton_Click"/>
                <Button x:Name="PortFixButton" Content="修复端口保留（需管理员）" Width="176" Height="34" Margin="8,0,0,0" Visibility="Collapsed" Click="PortFixButton_Click"/>
                <Button x:Name="LaunchButton" Content="启动 DeepSeek Harness" Width="172" Height="34" Margin="8,0,0,0" Visibility="Collapsed" Click="LaunchButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PortableButton" Content="直接运行（不安装）" Height="34" Click="PortableButton_Click"/>
                <Button Content="关闭" Width="70" Height="34" Margin="8,0,0,0" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
